# Copia a .env (NO se sube al repositorio) y cambia el secreto.
WEBHOOK_SECRET=cambia-este-secreto
# Token Bearer del rol admin: obligatorio para /api/* fuera de la demo y para reprocesar.
ADMIN_TOKEN=cambia-este-token
# DEMO_MODE=true  -> lectura anónima + simulador (solo para la demo pública)
DATABASE_URL=sqlite:///./webhooks.db
DOWNSTREAM_URL=http://127.0.0.1:9000/ingest
# DOWNSTREAM_FORMAT=triaje  -> entrega issues abiertos a triaje-solicitudes (ver docker-compose.triaje.yml)
# Opcionales (valores por defecto en backend/app/config.py)
# MAX_ATTEMPTS=6
# RETRY_BASE_SECONDS=2
# RETRY_CAP_SECONDS=300
# Solo para el destino simulado:
# FAILURE_RATE=0.3
